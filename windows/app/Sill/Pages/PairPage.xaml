<local:SillPage
    x:Class="Sill.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sill">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40">
            <TextBlock Text="Pair a device" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Pair once, and Sill on your iPhone or iPad reaches this PC at home and, with Tailscale, from anywhere." />

            <!-- Not pairing yet. -->
            <Border x:Name="Closed" Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xED14;" FontSize="32" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Show a pairing code" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="A QR code and a 12-digit code, good for 5 minutes. Only the device that uses it can pair." />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start pairing" Style="{StaticResource AccentButtonStyle}" MinWidth="140" VerticalAlignment="Center" Click="OnStart" />
                </Grid>
            </Border>

            <!-- Pairing open: the QR, the code, and how long it lasts. -->
            <Border x:Name="Open" Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="QrBox" Width="204" Height="204" Background="White" CornerRadius="8" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="QrCanvas" Width="21" Height="21">
                                <Path x:Name="QrPath" Fill="Black" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="Scan this code with Sill on your iPhone or iPad" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Or tap Add a Mac (or Add Computer) › Type address and code, and enter:" />
                        <TextBlock x:Name="CodeText" FontFamily="{StaticResource MonoFont}" FontSize="32" CharacterSpacing="80" IsTextSelectionEnabled="True" />
                        <StackPanel Spacing="6" MaxWidth="320" HorizontalAlignment="Left">
                            <ProgressBar x:Name="ExpiresBar" Maximum="300" Width="320" />
                            <TextBlock x:Name="ExpiresText" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnCopyCode">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="Copy code" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnStart">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="New code" />
                                </StackPanel>
                            </Button>
                            <Button Content="Stop pairing" Click="OnStop" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="How your device reaches this PC" Style="{StaticResource SectionHeader}" />
            <StackPanel x:Name="AddressList" Spacing="4" />

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,20,0,0"
                     Title="Only devices you pair can connect"
                     Message="Pairing stays open for 5 minutes or until a device pairs. You can remove a device at any time in Devices." />
        </StackPanel>
    </ScrollViewer>
</local:SillPage>
