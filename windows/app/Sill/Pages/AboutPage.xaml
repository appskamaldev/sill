<local:SillPage
    x:Class="Sill.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sill">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40" Spacing="4">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <Image Source="ms-appx:///Assets/sill-256.png" Width="64" Height="64" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Sill for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Your Windows PC on your iPhone and iPad: see it, control it, launch its apps." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Text="Sill sends this PC's picture only to devices you pair, encrypted end to end (TLS 1.3, keys pinned at pairing). No account, no cloud, no telemetry: nothing leaves your network except through your own Tailscale." />
            </Border>

            <TextBlock Text="Open source" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Text="Sill is open source under the Apache License 2.0. The Windows host is built with Rust (windows-rs, rustls, tokio and others; MIT, Apache-2.0, ISC and BSD-3-Clause licences) and this app with the Windows App SDK (MIT) on .NET (MIT)." />
                    <HyperlinkButton Content="github.com/appskamaldev/sill" NavigateUri="https://github.com/appskamaldev/sill" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SillPage>
