<local:SillPage
    x:Class="Sill.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sill">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40" HorizontalAlignment="Stretch">
            <TextBlock Text="Status" Style="{StaticResource PageTitle}" />

            <!-- What is happening, and the two things to do about it. -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDisc" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <FontIcon x:Name="StateIcon" Glyph="&#xE7F4;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateTitle" Text="Ready for your devices" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StateDetail" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Open Sill on your iPhone or iPad to see and control this PC." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Click="OnPause" MinWidth="120">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="14" />
                                <TextBlock x:Name="PauseText" Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button Content="Pair a device" Style="{StaticResource AccentButtonStyle}" Click="OnPair" MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live numbers, while something streams. -->
            <Grid x:Name="StatsGrid" ColumnSpacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Grid.Column="0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Frame rate" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="FpsText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Delay on this PC" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="LatencyText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Data rate" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="RateText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="3">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Sill's CPU · memory" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="CostText" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Connected now" Style="{StaticResource SectionHeader}" />
            <StackPanel x:Name="SessionList" Spacing="4" />
            <Border x:Name="NoSessions" Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No device is connected." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="This PC" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="24" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name devices see" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="NameText" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="Showing" Grid.Row="1" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceText" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="Reach it at" Grid.Row="2" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SillPage>
