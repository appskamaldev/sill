<local:SillPage
    x:Class="Sill.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sill">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40" Spacing="4">
            <TextBlock Text="Streaming" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="How this PC's picture is sent. Your iPhone or iPad can change these too, from its own settings." />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9E9;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Quality" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Higher looks sharper and needs a faster connection. Balanced suits most Wi‑Fi." Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <ComboBox x:Name="QualityBox" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnQuality" AutomationProperties.Name="Quality" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Resolution" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Full uses every pixel of the screen. Standard uses Windows' scaled size: smaller, and quicker to send." Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <ComboBox x:Name="ScaleBox" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnScale" AutomationProperties.Name="Resolution">
                        <ComboBoxItem Content="Full resolution" Tag="2" />
                        <ComboBoxItem Content="Standard (scaled)" Tag="1" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEC4A;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Frame rate limit" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Never more than your screen's refresh rate." Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <ComboBox x:Name="FpsBox" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnFps" AutomationProperties.Name="Frame rate limit">
                        <ComboBoxItem Content="60 frames per second" Tag="60" />
                        <ComboBoxItem Content="120 frames per second" Tag="120" />
                    </ComboBox>
                </Grid>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                     Message="These settings last until Sill restarts. A device that changes them changes them for every device." />
        </StackPanel>
    </ScrollViewer>
</local:SillPage>
